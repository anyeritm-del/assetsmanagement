# Auth.js (NextAuth) session encryption. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Canonical app URL. http://localhost:3000 for local dev; your Vercel URL in production.
AUTH_URL=http://localhost:3000

# OAuth 2.0 Client ID (Web application) used for user sign-in via Google.
# Create in Google Cloud Console > APIs & Services > Credentials.
# Authorized redirect URI: <AUTH_URL>/api/auth/callback/google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Service account used for Google Drive access (photo storage) and the one-time Sheets import.
# Create in Google Cloud Console > IAM & Admin > Service Accounts, then download a JSON key.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key from the JSON key file. Keep the literal "\n" sequences -- the app
# unescapes them at runtime (see lib/google/auth.ts).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Refresh token for a real Workspace user's own Drive access, used only for photo uploads.
# Service accounts have zero Drive storage quota of their own, so uploading a new file with the
# service account's own credentials fails with "Service Accounts do not have storage quota".
# Generated once via a manual OAuth consent flow (no Workspace admin access needed) -- see
# SETUP.md section 2b.
GOOGLE_DRIVE_REFRESH_TOKEN=

# PostgreSQL connection string (Sumopod), e.g.
# postgresql://user:password@dedicated-pooler.sumobase.my.id:7433/asset_management
# TLS is always verified (see SETUP.md section 4); `sslmode` is ignored except sslmode=disable.
DATABASE_URL=
# Optional: max connections per server instance (default 5).
DATABASE_POOL_MAX=

# Only needed for the one-time import from the old Google Sheet (scripts/migrate-sheets-to-postgres.ts).
# Share the sheet with GOOGLE_SERVICE_ACCOUNT_EMAIL (Viewer is enough).
# Copy the ID from the sheet's URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# A regular folder in My Drive (owned by, or shared as Editor with, both
# GOOGLE_SERVICE_ACCOUNT_EMAIL and the user behind GOOGLE_DRIVE_REFRESH_TOKEN) where
# item/purchase-order photos are uploaded. Copy its ID from the folder's URL.
GOOGLE_DRIVE_FOLDER_ID=

# Only Google accounts on this email domain may sign in.
ALLOWED_EMAIL_DOMAIN=astonhotelsinternational.com

# Optional: comma-separated list of specific email addresses allowed to sign in even though
# they're outside ALLOWED_EMAIL_DOMAIN (e.g. a personal account for an admin/tester).
ALLOWED_EMAILS=
